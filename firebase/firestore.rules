rules_version='2';
service cloud.firestore{match /databases/{database}/documents{
 function ok(){return request.auth!=null}
 function ord(o){return get(/databases/$(database)/documents/orders/$(o)).data}
 function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data}
 function active(){return ok()&&me().get('disabled',false)==false}
 function full(){return me().role=='admin'||me().get('perms',{}).get('full',false)==true}
 function can(p){return active()&&(full()||me().get('perms',{}).get(p,false)==true)}
 function bal(u){return get(/databases/$(database)/documents/balances/$(u)).data.get('amount',0)}
 function balA(u){return getAfter(/databases/$(database)/documents/balances/$(u)).data.get('amount',0)}
 function paid(){return bal(request.auth.uid)-balA(request.auth.uid)}
 function money(){return active()&&(full()||can('wallet.credit')||can('customers.wallet'))}
 function newsW(){return active()&&(full()||can('products.create')||can('products.edit')||can('blog.manage')||can('promotions.manage')||can('settings.manage'))}
 function d(){return request.resource.data.diff(resource.data).affectedKeys()}
 function step(a,b){return (a=='PLACED'&&b in ['APPROVED','REJECTED'])||(a=='APPROVED'&&b in ['PACKING','CANCELLED'])||(a=='PACKING'&&b in ['READY','CANCELLED'])||(a=='READY'&&b in ['OUT_FOR_DELIVERY','CANCELLED'])||(a=='OUT_FOR_DELIVERY'&&b in ['DELIVERED','DELIVERY_EXCEPTION'])}
 match /users/{u}{
  allow read:if ok()&&(request.auth.uid==u||can('users.view'));
  allow create:if ok()&&request.auth.uid==u&&request.resource.data.keys().hasOnly(['name','phone','role','ruthId','ref','createdAt'])&&request.resource.data.ruthId is string&&getAfter(/databases/$(database)/documents/ruthIds/$(request.resource.data.ruthId)).data.uid==request.auth.uid&&request.resource.data.phone.size()>=10&&(request.resource.data.role=='customer'||(request.resource.data.role=='admin'&&!exists(/databases/$(database)/documents/settings/setup)&&getAfter(/databases/$(database)/documents/settings/setup).data.adminUid==request.auth.uid));
  allow update:if ok()&&((request.auth.uid==u&&d().hasOnly(['name','phone','photo'])&&(!d().hasAny(['photo'])||request.resource.data.photo.matches('https://res.cloudinary.com/.*')))||(active()&&(me().role=='admin'||(can('customers.wallet')&&d().hasOnly(['refPaid'])))));
 }
 match /products/{p}{
  allow read:if resource.data.active==true||can('products.view')||(ok()&&resource.data.get('partner','')==request.auth.uid);
  allow create:if can('products.create')||(active()&&me().role=='partner'&&request.resource.data.keys().hasOnly(['name','unit','desc','price','was','img','stock','active','status','partner','partnerName','createdAt'])&&request.resource.data.partner==request.auth.uid&&request.resource.data.active==false&&request.resource.data.status=='PENDING'&&request.resource.data.price is number&&request.resource.data.price>0&&request.resource.data.desc.size()<=600&&(request.resource.data.img==''||request.resource.data.img.matches('https://res.cloudinary.com/.*'))&&request.resource.data.createdAt==request.time);
  allow update:if (can('products.edit')&&(!d().hasAny(['price'])||can('products.change_price')))||(active()&&me().role=='partner'&&resource.data.get('partner','')==request.auth.uid&&d().hasOnly(['name','unit','desc','price','was','img','stock','active','status'])&&request.resource.data.active==false&&request.resource.data.status=='PENDING'&&request.resource.data.price>0&&request.resource.data.desc.size()<=600&&(request.resource.data.img==''||request.resource.data.img.matches('https://res.cloudinary.com/.*')));
  allow update:if can('reviews.moderate')&&d().hasOnly(['rating','reviewsN']);
  allow update:if can('orders.update_status')&&d().hasOnly(['qty','sold']);
  allow delete:if can('products.edit');
 }
 match /zones/{z}{allow read:if resource.data.active==true||can('zones.manage');allow create,update:if can('zones.manage');}
 match /promos/{c}{allow get:if resource.data.active==true;allow list,create,update:if can('promotions.manage');}
 match /reviews/{r}{
  allow read:if resource.data.status=='PUBLISHED'||can('reviews.moderate')||(ok()&&resource.data.uid==request.auth.uid);
  allow create:if active()&&r==request.auth.uid+'_'+request.resource.data.pid&&request.resource.data.keys().hasOnly(['pid','pname','oid','uid','name','rating','text','status','createdAt'])&&ord(request.resource.data.oid).uid==request.auth.uid&&ord(request.resource.data.oid).status=='DELIVERED'&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=='PENDING'&&request.resource.data.rating is int&&request.resource.data.rating>=1&&request.resource.data.rating<=5&&request.resource.data.text.size()<=1000&&request.resource.data.createdAt==request.time;
  allow update:if can('reviews.moderate')&&d().hasOnly(['status']);
 }
 match /jobs/{j}{allow read:if resource.data.active==true||can('careers.manage');allow create,update:if can('careers.manage');}
 match /applications/{a}{
  allow create:if request.resource.data.keys().hasOnly(['jobId','jobTitle','name','email','phone','cv','note','status','createdAt'])&&request.resource.data.status=='SUBMITTED'&&request.resource.data.name.size()<=100&&request.resource.data.note.size()<=1500&&request.resource.data.cv.matches('https://.*')&&request.resource.data.createdAt==request.time;
  allow read:if can('careers.view_applications');
  allow update:if can('careers.update_application_status')&&d().hasOnly(['status']);
 }
 match /chats/{c}{
  allow read:if ok()&&(c==request.auth.uid||can('support.reply'));
  allow create:if ok()&&request.resource.data.keys().hasOnly(['uid','name','status','last','lastRole','updatedAt','assignedTo'])&&request.resource.data.uid==c&&(can('support.reply')||(c==request.auth.uid&&!('assignedTo' in request.resource.data)));
  allow update:if ok()&&((c==request.auth.uid&&d().hasOnly(['last','lastRole','updatedAt','status']))||can('support.reply'));
  match /messages/{m}{
   allow read:if ok()&&(c==request.auth.uid||can('support.reply'));
   allow create:if ok()&&request.resource.data.keys().hasOnly(['from','role','text','at'])&&request.resource.data.from==request.auth.uid&&request.resource.data.text.size()<=1000&&request.resource.data.at==request.time&&((c==request.auth.uid&&request.resource.data.role=='customer')||(can('support.reply')&&request.resource.data.role=='staff'));
  }
 }
 match /posts/{p}{
  allow read:if resource.data.published==true||can('blog.manage');
  allow create,update,delete:if can('blog.manage');
  match /likes/{u}{allow read:if true;allow create:if ok()&&u==request.auth.uid&&request.resource.data.keys().hasOnly(['at']);allow delete:if ok()&&u==request.auth.uid;}
  match /shares/{u}{allow read:if true;allow create:if ok()&&u==request.auth.uid&&request.resource.data.keys().hasOnly(['at']);}
  match /comments/{c}{
   allow read:if true;
   allow create:if ok()&&request.resource.data.keys().hasOnly(['uid','name','text','photo','at','parent'])&&(!('parent' in request.resource.data)||request.resource.data.parent is string)&&(request.resource.data.photo==''||request.resource.data.photo.matches('https://res.cloudinary.com/.*'))&&request.resource.data.uid==request.auth.uid&&request.resource.data.text.size()<=500&&request.resource.data.at==request.time;
   allow delete:if ok()&&(resource.data.uid==request.auth.uid||can('blog.moderate'));
   match /likes/{u}{allow read:if true;allow create:if ok()&&u==request.auth.uid&&request.resource.data.keys().hasOnly(['at']);allow delete:if ok()&&u==request.auth.uid;}
  }
 }
 match /settings/{s}{
  allow get:if s in ['public','setup','news'];
  allow create:if (s=='setup'&&ok()&&request.resource.data.keys().hasOnly(['adminUid','at'])&&request.resource.data.adminUid==request.auth.uid&&getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='admin')||(s=='public'&&can('settings.manage'))||(s=='news'&&newsW());
  allow update:if (s=='public'&&can('settings.manage'))||(s=='news'&&newsW());
 }
 match /wallet/{u}/ledger/{e}{allow read:if ok()&&(u==request.auth.uid||can('customers.view'));allow create:if active()&&request.resource.data.keys().hasOnly(['amount','reason','by','ref','at']);}
 match /balances/{u}{allow read:if ok()&&(u==request.auth.uid||can('customers.view'));
  allow create:if active()&&(money()||(u==request.auth.uid&&request.resource.data.get('amount',0)==0)||request.resource.data.get('amount',0)<=paid());
  allow update:if active()&&(money()||(u==request.auth.uid&&request.resource.data.get('amount',0)<=resource.data.get('amount',0))||request.resource.data.get('amount',0)-resource.data.get('amount',0)<=paid());}
 match /secrets/{u}{allow read,write:if ok()&&u==request.auth.uid;}
 match /ruthIds/{i}{
  allow get:if ok();
  allow create:if ok()&&request.resource.data.keys().hasOnly(['uid','name'])&&request.resource.data.uid==request.auth.uid;
  allow update:if ok()&&(resource.data.uid==request.auth.uid||me().role=='admin')&&d().hasOnly(['name']);
 }
 match /crm/{u}{allow read:if can('customers.view');allow write:if can('customers.manage');}
 match /events/{e}{
  allow create:if request.resource.data.keys().hasOnly(['t','ref','vid','at'])&&request.resource.data.t in ['page','add_to_cart','order','open_cart','post_view','like','share','comment']&&request.resource.data.ref.size()<=100&&request.resource.data.vid.size()<=60&&request.resource.data.at==request.time;
  allow read:if can('analytics.view');
 }
 match /deposits/{i}{
  allow read:if ok()&&(resource.data.uid==request.auth.uid||can('wallet.credit')||can('wallet.monitor')||can('customers.view'));
  allow create:if ok()&&request.resource.data.keys().hasOnly(['uid','name','ruthId','amount','status','at'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=='PENDING'&&request.resource.data.amount is number&&request.resource.data.amount>=100&&request.resource.data.amount<=1000000&&request.resource.data.at==request.time;
  allow update:if ok()&&resource.data.uid==request.auth.uid&&resource.data.status=='PENDING'&&d().hasOnly(['status'])&&request.resource.data.status=='CANCELLED';
  allow update:if can('wallet.credit')&&d().hasOnly(['status','credited','by','creditedAt']);
 }
 match /withdrawals/{i}{allow read:if ok()&&(resource.data.uid==request.auth.uid||can('wallet.monitor')||can('customers.view'));
  allow create:if active()&&request.resource.data.keys().hasOnly(['uid','name','ruthId','phone','amount','bank','acct','acctName','status','at'])&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=='PENDING'&&request.resource.data.amount<=paid();
  allow update:if active()&&me().role=='admin'&&d().hasOnly(['status','note','by','updatedAt']);}
 match /transactions/{i}{allow read:if can('wallet.monitor');allow create:if active()&&request.resource.data.keys().hasOnly(['type','uid','ruthId','name','amount','reason','by','byName','ref','at']);}
 match /allocations/{u}{allow read:if ok()&&(u==request.auth.uid||can('wallet.monitor'));allow write:if active()&&(me().role=='admin'||(u==request.auth.uid&&request.resource.data.remaining<resource.data.get('remaining',0)));}
 match /sections/{x}{allow read:if resource.data.active==true||can('products.view');allow create,update,delete:if can('products.edit');}
 match /partners/{u}{
  allow read:if ok()&&(u==request.auth.uid||me().role=='admin');
  allow create:if ok()&&u==request.auth.uid&&request.resource.data.keys().hasOnly(['uid','name','business','phone','about','status','at'])&&request.resource.data.uid==u&&request.resource.data.status=='PENDING'&&request.resource.data.about.size()<=600&&request.resource.data.at==request.time;
  allow update:if me().role=='admin'&&d().hasOnly(['status','note']);
 }
 match /payRequests/{c}{
  allow get:if ok();
  allow list:if ok()&&resource.data.requesterUid==request.auth.uid;
  allow create:if active()&&request.resource.data.keys().hasOnly(['requesterUid','requesterName','items','sub','fee','discount','promo','zone','total','contact','status','expiresAt','createdAt'])&&request.resource.data.requesterUid==request.auth.uid&&request.resource.data.status=='OPEN'&&request.resource.data.createdAt==request.time;
  allow update:if active()&&resource.data.status=='OPEN'&&d().hasOnly(['status','orderId','paidBy','paidAt'])&&request.resource.data.status=='PAID'&&request.resource.data.paidBy==request.auth.uid;
  allow update:if ok()&&resource.data.requesterUid==request.auth.uid&&resource.data.status=='OPEN'&&d().hasOnly(['status'])&&request.resource.data.status=='CANCELLED';
 }
 match /live/{o}{
  allow read:if ok()&&(ord(o).uid==request.auth.uid||ord(o).get('riderId','')==request.auth.uid||can('orders.view'));
  allow write:if ok()&&ord(o).get('riderId','')==request.auth.uid&&request.resource.data.keys().hasOnly(['lat','lng','by','at'])&&request.resource.data.by==request.auth.uid;
 }
 match /orders/{o}{
  allow get:if true;
  allow list:if ok()&&(resource.data.uid==request.auth.uid||resource.data.get('riderId','')==request.auth.uid||can('orders.view'));
  allow create:if request.resource.data.keys().hasOnly(['uid','items','total','fee','discount','promo','zone','contact','method','status','code','createdAt','pay','paidByUid','paidByName'])&&request.resource.data.status=='PLACED'&&request.resource.data.createdAt==request.time&&((!ok()&&request.resource.data.get('uid',null)==null)||(ok()&&request.resource.data.get('uid',null)==request.auth.uid)||request.resource.data.get('paidByUid','')==request.auth.uid)&&(request.resource.data.pay=='PENDING'||(active()&&request.resource.data.paidByUid==request.auth.uid&&request.resource.data.total<=paid()));
  allow update:if active()&&(full()||can('customers.wallet'))&&d().hasOnly(['refunded']);
  allow update:if active()&&d().hasOnly(['status','riderId','pay','updatedAt'])&&(
   (resource.data.get('riderId','')==request.auth.uid&&d().hasOnly(['status','updatedAt'])&&resource.data.status=='OUT_FOR_DELIVERY'&&request.resource.data.status in ['DELIVERED','DELIVERY_EXCEPTION'])
   ||(can('orders.view')&&(!d().hasAny(['status'])||(can('orders.update_status')&&step(resource.data.status,request.resource.data.status)))&&(!d().hasAny(['riderId'])||can('orders.assign_rider'))&&(!d().hasAny(['pay'])||can('payments.verify'))));
  match /events/{e}{
   allow read:if true;
   allow create:if (active()&&request.resource.data.by==request.auth.uid)||request.resource.data.by=='guest';
  }
  match /chat/{m}{
   allow read:if ok()&&(ord(o).uid==request.auth.uid||ord(o).get('riderId','')==request.auth.uid||can('support.reply'));
   allow create:if ok()&&request.resource.data.keys().hasOnly(['from','role','text','at'])&&request.resource.data.from==request.auth.uid&&request.resource.data.text.size()<=500&&request.resource.data.at==request.time&&((request.resource.data.role=='customer'&&ord(o).uid==request.auth.uid)||(request.resource.data.role=='rider'&&ord(o).get('riderId','')==request.auth.uid)||(request.resource.data.role=='staff'&&can('support.reply')));
  }
 }
}}
